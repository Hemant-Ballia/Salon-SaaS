# ============================
# Application
# ============================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================
# Database — Supabase PostgreSQL
# ============================
# Connection pooling URL (used by Prisma at runtime via PgBouncer)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Direct connection URL (used by Prisma for migrations, bypasses pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ============================
# Supabase
# ============================
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# ============================
# JWT
# ============================
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# Redis (optional for local dev)
# ============================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================
# CORS — Frontend URLs
# ============================
CUSTOMER_FRONTEND_URL=http://localhost:3000
BUSINESS_FRONTEND_URL=http://localhost:3001
STAFF_FRONTEND_URL=http://localhost:3002
ADMIN_FRONTEND_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ============================
# OTP Configuration
# ============================
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SMS_ENABLED=true
OTP_WHATSAPP_ENABLED=true
OTP_EMAIL_ENABLED=true

# ============================
# SMS — Twilio
# ============================
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM=""

# ============================
# WhatsApp — Twilio
# ============================
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=""
WHATSAPP_AUTH_TOKEN=""
WHATSAPP_FROM=""

# ============================
# Email — SMTP / Nodemailer
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
EMAIL_OTP_SUBJECT="Your Salon SaaS Verification Code"

# ============================
# Razorpay
# ============================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ============================
# File Upload
# ============================
MAX_FILE_SIZE_MB=5

# ============================
# Logging
# ============================
LOG_LEVEL=development
